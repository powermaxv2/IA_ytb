<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Updates of the app itself, published as GitHub releases (Android asks the user to allow it once). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Keeps the periodic update check after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- QR code tool (live scanner) and Scanner tool (photos of pages): asked the first time the camera is needed; the camera is optional. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- Gomme: lets Gulp read the real GPS of the photos it cleans (Android 10+ blanks it otherwise), to show it. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Coffre-fort: optional fingerprint unlock (the code always works). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Doublons photos: reads the gallery's photos to find the copies (asked when the tool opens). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Only needed to save into the public folders on Android 9 and older. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Stickers: lets Gulp see whether WhatsApp (or WhatsApp Business) is installed, to hand it a sticker pack. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- Lecture à voix haute: Android 11+ hides the speech engines from apps that do not ask for them. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.YTDownloader"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Partager" from the YouTube, Instagram, X, TikTok… apps. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Partager → Convertir avec Gulp": any file, opened in the Convertisseur (MainActivity reads EXTRA_STREAM,
             content:// only). -->
        <activity-alias
            android:name=".ConvertEntry"
            android:exported="true"
            android:label="@string/convert_label"
            android:targetActivity=".MainActivity">
            <intent-filter android:label="@string/convert_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <!-- "Partager → Aperçu avec Gulp" and "Ouvrir avec → Gulp": any file, opened in the Aperçu tool. -->
        <activity-alias
            android:name=".PreviewEntry"
            android:exported="true"
            android:label="@string/preview_label"
            android:targetActivity=".MainActivity">
            <intent-filter android:label="@string/preview_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <!-- "Exporter la discussion → Analyser avec Gulp" from WhatsApp: the .zip of a discussion, opened in
             "Vu, répondu" (MainActivity reads EXTRA_STREAM, content:// only). No text/plain here: a second SEND
             text/plain filter next to MainActivity's made some phones refuse the APK ("package non valide", 1.10.0);
             a shared .txt file goes through MainActivity's filter instead. -->
        <activity-alias
            android:name=".ChatEntry"
            android:exported="true"
            android:label="@string/chat_label"
            android:targetActivity=".MainActivity">
            <intent-filter android:label="@string/chat_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity-alias>

        <!-- "Partager → Compresser avec Gulp": a photo, video, sound or PDF, opened in the Compresseur (MainActivity
             reads EXTRA_STREAM, content:// only). Media and PDF types only: never text/plain (see ChatEntry). -->
        <activity-alias
            android:name=".CompressEntry"
            android:exported="true"
            android:label="@string/compress_label"
            android:targetActivity=".MainActivity">
            <intent-filter android:label="@string/compress_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity-alias>

        <!-- "Partager → Transcrire avec Gulp": a voice note (WhatsApp .opus, a memo, any sound), opened in Vocaux en
             texte (MainActivity reads EXTRA_STREAM, content:// only). Sound types only: never text/plain (see ChatEntry). -->
        <activity-alias
            android:name=".VoiceEntry"
            android:exported="true"
            android:label="@string/voice_label"
            android:targetActivity=".MainActivity">
            <intent-filter android:label="@string/voice_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity-alias>

        <!-- Entry of the "Mise à jour disponible" notification: not exported, so other apps cannot start an update. -->
        <activity-alias
            android:name=".UpdateEntry"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- The Scanner hands the camera app a content:// URI of a new file in Gulp's private work folder, so the photo
             never lands in the Gallery. Not exported: the camera app only gets the one URI it is granted. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Stickers: WhatsApp reads the packs made in Gulp from here (WhatsApp's sticker contract). Only WhatsApp can
             read it (its own permission); it lists the packs and opens their .webp files, read-only. -->
        <provider
            android:name=".core.sticker.StickerProvider"
            android:authorities="${applicationId}.stickers"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />

        <service
            android:name=".core.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".core.UpdateCheckJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".core.InstallStatusReceiver"
            android:exported="false" />

        <receiver
            android:name=".core.AppReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
